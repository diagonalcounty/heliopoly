# Copy to backlog.env (gitignored) after you know project number.
# Find number: open the Project in browser — URL ends in /projects/N

HELIOPOLY_REPO=diagonalcounty/heliopoly
HELIOPOLY_PROJECT_OWNER=diagonalcounty
HELIOPOLY_PROJECT_NUMBER=1

# Optional: only cards in this Status column (exact name on the board)
# Leave empty to include all open issues on the project, in board POSITION order.
# HELIOPOLY_BACKLOG_STATUS=Todo
