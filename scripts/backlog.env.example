# Copy to backlog.env (gitignored) after you know project number.
# Find number: open the Project in browser — URL ends in /projects/N

HELIOPOLY_REPO=diagonalcounty/heliopoly
HELIOPOLY_PROJECT_OWNER=diagonalcounty
# Heliopoly Kanban: https://github.com/users/diagonalcounty/projects/2
HELIOPOLY_PROJECT_NUMBER=2

# Optional: only cards in this Status column (exact name on the board)
# Leave empty to include all open issues on the project, in board POSITION order.
#
# Exact Status options: Backlog | Ready | In progress | In review | Done
# Meanings (see vault heliopoly skill):
#   In progress  = claimed for this AI session
#   In review    = test locally before live
#   Done         = deployed successfully to https://heliopoly.live/
# HELIOPOLY_BACKLOG_STATUS=In progress
