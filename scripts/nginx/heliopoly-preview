# preview.heliopoly.live — permanent redirect to beta (#134 host rename).
# Keep ACME so the preview name stays on the heliopoly.live cert.
# Does not serve the game. Does not write /var/www/heliopoly (#98).

server {
    listen 80;
    listen [::]:80;
    server_name preview.heliopoly.live;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://beta.heliopoly.live$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name preview.heliopoly.live;

    ssl_certificate /etc/letsencrypt/live/heliopoly.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heliopoly.live/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://beta.heliopoly.live$request_uri;
    }
}
