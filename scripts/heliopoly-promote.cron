# Heliopoly PRD promote — droplet only (heliopoly.live host).
# Install:  install -o root -g root -m 644 scripts/heliopoly-promote.cron /etc/cron.d/heliopoly-promote
# Debian cron ignores the file unless it is owned by root (not a Mac uid).
#
# Time base: UTC (droplet timezone Etc/UTC). Product law: Sunday 00:01 UTC (#98).
# Does not build — only promotes a dist already staged under /var/www/heliopoly-releases/.
# Daily 00:01 UTC (#231): enabledAfter is the real gate. A weekly Sunday-only crontab
# skipped 1.3.0 after pending.json was set to Thursday 2026-12-31.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
CRON_TZ=UTC

# minute hour dom month dow — every day; script no-ops until enabledAfter
1 0 * * * root /usr/local/bin/heliopoly-promote-next
