# Heliopoly PRD promote — droplet only (heliopoly.live host).
# Install:  cp scripts/heliopoly-promote.cron /etc/cron.d/heliopoly-promote
#           chmod 644 /etc/cron.d/heliopoly-promote
#
# Time base: UTC (droplet timezone Etc/UTC). Product law: Sunday 00:01 UTC (#98).
# Does not build — only promotes a dist already staged under /var/www/heliopoly-releases/.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
CRON_TZ=UTC

# minute hour dom month dow
1 0 * * 0 root /usr/local/bin/heliopoly-promote-next
